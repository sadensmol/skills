[Unit]
Description=autopilot remote: sshd host key and authorized keys in the state volume
Before=ssh.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'install -d -m 0755 /var/lib/autopilot-remote/ssh && cd /var/lib/autopilot-remote/ssh && { [ -f ssh_host_ed25519_key ] || ssh-keygen -q -t ed25519 -N "" -f ssh_host_ed25519_key; } && touch authorized_keys && chmod 0644 authorized_keys && mkdir -p /run/sshd'

[Install]
WantedBy=multi-user.target
